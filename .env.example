# ============================================================
# Plume d'Ombres — variables d'environnement
# Copie ce fichier en `.env.local` et remplis les valeurs.
# NE COMMET JAMAIS ce fichier : il contient des secrets.
# ============================================================

# --- Supabase -------------------------------------------------
# URL du projet Supabase (http://127.0.0.1:54321 en local avec
# `supabase start`, ou https://xxxx.supabase.co en production).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé publique « anon » (sans danger côté navigateur : la sécurité
# repose sur les politiques RLS, pas sur cette clé).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Traduction ----------------------------------------------
# Fournisseur actif : 'libretranslate' (défaut, local & gratuit),
# 'gemini' (Flash gratuit — VITESSE + qualité littéraire ; nécessite
# GEMINI_API_KEY) ou 'mymemory' (secours sans clé, ~50 000 car./jour).
TRANSLATOR_DEFAULT=libretranslate

# Clé API Gemini (AI Studio — https://aistudio.google.com/apikey) :
# gratuite, sans carte. ~1 500 requêtes/jour (≈ plusieurs livres).
# Modèle : gemini-2.5-flash par défaut (GEMINI_MODEL pour changer).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# URL de l'instance LibreTranslate :
#   - local : http://127.0.0.1:5000  (Docker ou `libretranslate` natif)
#   - cloud : https://votre-sous-domaine.onrender.com ou IP de la VM Oracle
LIBRETRANSLATE_URL=http://127.0.0.1:5000

# Clé API LibreTranslate (facultatif, si l'instance l'exige)
# LIBRETRANSLATE_API_KEY=

# Email envoyé à MyMemory pour bénéficier du quota supérieur (facultatif)
# MYMEMORY_EMAIL=votre@email.com
